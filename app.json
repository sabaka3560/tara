{
  "expo": {
    "name": "Tara",
    "slug": "tara",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tara",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "android": {
      "package": "com.tara.wardrobe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-camera",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
