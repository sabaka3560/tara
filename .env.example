# Flipkart Affiliate API — https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Amazon Product Advertising API v5 — https://affiliate-program.amazon.in/
AMAZON_ASSOC_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# Myntra / Nykaa affiliate IDs (for URL attribution, optional)
MYNTRA_AFFILIATE_ID=
NYKAA_AFFILIATE_ID=

# Misc
ADMOB_APP_ID=
OPENWEATHER_API_KEY=
